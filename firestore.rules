rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function couplePath(coupleId) {
      return /databases/$(database)/documents/couples/$(coupleId);
    }

    function userHasNoCouple(uid) {
      return !exists(userPath(uid)) ||
        get(userPath(uid)).data.coupleId == null ||
        get(userPath(uid)).data.coupleId == '';
    }

    function isCoupleMember(coupleId) {
      return signedIn() &&
        exists(couplePath(coupleId)) &&
        request.auth.uid in get(couplePath(coupleId)).data.members;
    }

    function createsOwnPendingCouple() {
      return signedIn() &&
        request.resource.data.user1Id == request.auth.uid &&
        request.resource.data.user2Id == '' &&
        request.resource.data.members.size() == 1 &&
        request.resource.data.members[0] == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        userHasNoCouple(request.auth.uid);
    }

    function joinsPendingCouple() {
      return signedIn() &&
        resource.data.status == 'pending' &&
        resource.data.members.size() == 1 &&
        !(request.auth.uid in resource.data.members) &&
        request.resource.data.members.size() == 2 &&
        resource.data.members[0] in request.resource.data.members &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.user1Id == resource.data.user1Id &&
        request.resource.data.user2Id == request.auth.uid &&
        request.resource.data.status == 'active' &&
        userHasNoCouple(request.auth.uid);
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        request.auth.uid == uid ||
        (
          request.resource.data.coupleId is string &&
          request.resource.data.partnerId == request.auth.uid &&
          request.resource.data.coupleId == resource.data.coupleId &&
          request.auth.uid in getAfter(couplePath(resource.data.coupleId)).data.members
        )
      );
      allow delete: if false;
    }

    match /couples/{coupleId} {
      allow create: if createsOwnPendingCouple();
      allow read: if isCoupleMember(coupleId) ||
        (signedIn() && resource.data.status == 'pending');
      allow update: if joinsPendingCouple() || isCoupleMember(coupleId);
      allow delete: if false;

      match /dates/{document=**} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /notes/{document=**} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /gallery/{document=**} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /calendar/{document=**} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /counter/{document=**} {
        allow read, write: if isCoupleMember(coupleId);
      }
    }
  }
}
